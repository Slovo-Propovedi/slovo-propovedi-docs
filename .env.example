# Copy to .env for local `make prod-build` overrides — see Makefile
# (`-include .env`). Not read by anything else in this repo: the dev editor
# (docker-compose.dev.yml) and vps-deploy.sh take their config from the
# `make dev-*` targets / shell env respectively, not from this file.
#
# Bare hostname only (no protocol, no path, no trailing slash).
# These values mirror the org's Forgejo Actions variables of the same name —
# keep both in sync. The Docker build FAILS without BACKEND_API_HOSTNAME.

# Dev example value — override with your real API hostname.
BACKEND_API_HOSTNAME=localhost

# swagger-ui-dist version to bundle (see README.md).
# SWAGGER_UI_VERSION=5.32.15
